<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nội dung chính -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Location + Temp -->
            <TextView
                android:id="@+id/tvLocationAndTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/location_and_temp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:textSize="24sp"
                android:textAlignment="center"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="35dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 7 Days Forecast Title -->
            <TextView
                android:id="@+id/tv7DaysTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/days_title"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:fontFamily="@font/opensans_semibold"
                android:layout_marginTop="135dp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- RecyclerView Forecast -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv7DaysTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_forecast" />

            <!-- Air Quality Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAirQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/rvForecast"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Nội dung trong Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_air_quality"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Hàng tiêu đề -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icAirQuality"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_crosshairs"
                            app:tint="@android:color/white" />

                        <TextView
                            android:id="@+id/tvAirQuality"
                            android:text="@string/air_quality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/opensans_regular"/>
                    </LinearLayout>

                    <!-- Giá trị chất lượng không khí -->
                    <TextView
                        android:id="@+id/tvAirQualityDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="3 - Low Health Risk"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:fontFamily="@font/opensans_semibold"/>

                    <!-- Line -->
                    <View
                        android:id="@+id/viewDivider"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/line_gradient" />

                    <!-- See more -->
                    <TextView
                        android:id="@+id/tvSeeMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="See more"
                        android:fontFamily="@font/opensans_semibold"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        app:drawableEndCompat="@drawable/ic_chevron_left" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Cards: Sunrise & UV -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/groupBottomCards"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/cardAirQuality"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside">

                <!-- Sunrise -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSunrise"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@drawable/bg_card_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/cardUv"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontalWeight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:text="🌅 SUNRISE"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSunriseTime"
                            android:layout_marginTop="4dp"
                            android:text="5:28 AM"
                            android:textColor="@android:color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSunsetTime"
                            android:layout_marginTop="4dp"
                            android:text="Sunset: 7:25 PM"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- UV Index -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUv"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@drawable/bg_card_blue"
                    app:layout_constraintStart_toEndOf="@id/cardSunrise"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontalWeight="1">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:text="🌞 UV INDEX"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvUvValue"
                            android:text="4"
                            android:textColor="@android:color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvUvLevel"
                            android:text="Moderate"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
