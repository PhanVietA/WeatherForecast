<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Card hiển thị thời tiết hiện tại -->
    <androidx.cardview.widget.CardView
        android:id="@+id/weatherCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:id="@+id/mainWeatherIcon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_weather1"
                android:contentDescription="@string/cd_main_weather_icon" />

            <TextView
                android:id="@+id/currentTemp"
                android:fontFamily="@font/poppins_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/temperature"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/description"
                android:fontFamily="@font/poppins_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/maxMin"
                android:fontFamily="@font/poppins_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/max_min"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Ảnh nhà -->
    <ImageView
        android:id="@+id/houseImage"
        android:layout_width="359dp"
        android:layout_height="191dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@mipmap/house_image"
        android:contentDescription="@string/cd_house_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weatherCard" />

    <!-- Card chứa phần Forecast -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weatherForecastCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_weather_card"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/houseImage"
        app:layout_constraintVertical_bias="1">

        <!-- Hàng Today - Date -->
        <TextView
            android:id="@+id/todayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/opensans_semibold"
            android:letterSpacing="-0.01"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/julyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_month"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:letterSpacing="-0.01"
            android:fontFamily="@font/opensans_semibold"
            app:layout_constraintBaseline_toBaselineOf="@id/todayText"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Đường gạch ngang -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#80FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/todayText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hourlyRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_hourly_weather"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Thanh icon dưới -->
    <ImageButton
        android:id="@+id/iconLocation"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_location"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        android:contentDescription="@string/cd_location_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iconAdd"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <ImageButton
        android:id="@+id/iconAdd"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_plus_circle"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        android:contentDescription="@string/cd_add_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconLocation"
        app:layout_constraintEnd_toStartOf="@+id/iconMenu" />

    <ImageButton
        android:id="@+id/iconMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_menu"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        android:contentDescription="@string/cd_menu_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconAdd"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
